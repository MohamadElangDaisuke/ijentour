# ==============================================================================
# IJEN TOUR FULLSTACK - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION
# ==============================================================================

# --- [MODE 1: LOCAL DEVELOPMENT (AKTIF SAAT INI - SQLITE)] ---
# Database file lokal otomatis (prisma/dev.db), tidak perlu instal Postgres/MySQL/Docker.
# Tinggal jalankan: npm run dev
DATABASE_URL="file:./dev.db"

# --- [MODE 2: ONLINE / PRODUCTION (SUPABASE POSTGRESQL)] ---
# Jika ingin beralih ke Supabase PostgreSQL online:
# 1. Di prisma/schema.prisma ubah: provider = "postgresql" dan aktifkan directUrl = env("DIRECT_URL")
# 2. Buka komentar baris di bawah dan isi kredensial Supabase Anda:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- [MODE 3: ONLINE / PRODUCTION (MYSQL HOSTINGER)] ---
# Jika ingin beralih ke MySQL Hostinger online:
# 1. Di prisma/schema.prisma ubah: provider = "mysql"
# 2. Buka komentar baris di bawah dan isi kredensial MySQL Hostinger:
# DATABASE_URL="mysql://u[USER]:[PASSWORD]@[IP_ATAU_DOMAIN_HOSTINGER]:3306/[DATABASE_NAME]"


# ==============================================================================
# 2. AUTHENTICATION (JWT Session via jose)
# ==============================================================================
# Kunci rahasia untuk menandatangani dan memverifikasi token sesi login.
JWT_SECRET="ijen-tour-secret-key-super-secure-fullstack-2026"

# NextAuth Secret (untuk backward compatibility jika digunakan)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-in-production-fullstack"


# ==============================================================================
# 3. APPLICATION URL & BRANDING
# ==============================================================================
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ijen Tour"


# ==============================================================================
# 4. WHATSAPP CUSTOMER SERVICE & DIRECT BOOKING
# ==============================================================================
# Format nomor internasional tanpa simbol '+' (contoh: 6281234567890)
ADMIN_WHATSAPP_NUMBER="6281234567890"


# ==============================================================================
# 5. SUPABASE API KEYS (OPSIONAL - HANYA JIKA MENGGUNAKAN FITUR STORAGE SUPABASE)
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
