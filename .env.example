# ==============================================================================
# MOUNT IJEN TOUR FULLSTACK - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT:
# This file is a template only.
# Copy to .env and configure your actual credentials locally.
# NEVER commit .env or expose production secrets.
# ==============================================================================


# ==============================================================================
# 1. DATABASE CONFIGURATION - SUPABASE POSTGRESQL
# ==============================================================================

# Supabase Connection Pooler (Runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Prisma CLI / Database Management)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[DIRECT_HOST]:5432/postgres"


# ==============================================================================
# 2. AUTHENTICATION - JWT SESSION
# ==============================================================================

# Generate a cryptographically secure secret (minimum 32 bytes).
# Never use the example value in production.
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_bytes"

# NextAuth compatibility (only if required by the application).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_a_secure_random_secret"


# ==============================================================================
# 3. APPLICATION URL & BRANDING
# ==============================================================================

# Local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production example:
# NEXT_PUBLIC_APP_URL="https://www.mountijentour.com"

NEXT_PUBLIC_APP_NAME="Mount Ijen Tour"


# ==============================================================================
# 4. WHATSAPP CUSTOMER SERVICE
# ==============================================================================

# International format without '+' or spaces.
ADMIN_WHATSAPP_NUMBER="your_whatsapp_number"


# ==============================================================================
# 5. SUPABASE STORAGE (OPTIONAL)
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Server-side only. NEVER expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"


# ==============================================================================
# 6. GOOGLE GEMINI AI - SERVER SIDE ONLY
# ==============================================================================

# Google AI Studio:
# https://aistudio.google.com/apikey

GEMINI_API_KEY="your_gemini_api_key"

# NEVER use NEXT_PUBLIC_ prefix for this variable.


# ==============================================================================
# 7. RESEND - TRANSACTIONAL EMAIL & NOTIFICATIONS
# ==============================================================================

# Resend Dashboard:
# https://resend.com/api-keys

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

EMAIL_FROM="Mount Ijen Tour <noreply@mountijentour.com>"

ADMIN_NOTIFICATION_EMAIL="admin@example.com"


# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================