# ==============================================================================
# IJEN TOUR FULLSTACK - ENVIRONMENT VARIABLES CONFIGURATION (SUPABASE POSTGRESQL)
# ==============================================================================

# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler connection string (Port 6543) with pgbouncer=true.
# Recommended for serverless Next.js functions on Vercel to avoid connection exhaustion.
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct TCP connection string (Port 5432).
# Required by Prisma CLI for running migrations and schema push (prisma db push / prisma migrate).
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. SUPABASE API KEYS (Optional for Storage & Client SDK)
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # SERVER-ONLY, JANGAN EXPOSE KE CLIENT!

# 3. AUTHENTICATION (JWT Session)
# ------------------------------------------------------------------------------
# Secret key untuk enkripsi dan verifikasi JWT token (jose). Gunakan string acak minimal 32 karakter.
JWT_SECRET="ganti-dengan-string-acak-rahasia-minimal-32-karakter"

# 4. APPLICATION URL
# ------------------------------------------------------------------------------
# Development: http://localhost:3000
# Production Vercel: https://mount-ijen.vercel.app (atau domain kustom Anda)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ijen Tour"

# 5. WHATSAPP CUSTOMER SERVICE & DIRECT CONTACT
# ------------------------------------------------------------------------------
# Format nomor internasional tanpa simbol '+' (contoh: 6281234567890)
ADMIN_WHATSAPP_NUMBER="6281234567890"
