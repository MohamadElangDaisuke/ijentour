generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String    @id @default(cuid())
  username                String?   @unique
  name                    String
  email                   String    @unique
  emailVerified           DateTime?
  passwordHash            String?
  phone                   String?
  nationality             String?
  avatarUrl               String?
  role                    String    @default("CUSTOMER") // "CUSTOMER", "CUSTOMER_PRO", "MITRA", "ADMIN", "SUPER_ADMIN"
  notificationPreferences String?   @default("{\"booking\":true,\"customTrip\":true,\"review\":true,\"contact\":true}")
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  bookings Booking[]
  reviews  Review[]
  posts    BlogPost[]
  staff    Staff[]

  @@map("users")
}

model TripPackage {
  id                   String   @id @default(cuid())
  title                String
  slug                 String   @unique
  category             String   @default("regular") // "regular", "private", "midnight"
  description          String
  shortDescription     String?
  duration             String   @default("1 Hari")
  durationDays         Int      @default(1)
  durationNights       Int      @default(0)
  price                String   @default("Rp 750.000")
  basePrice            Float    @default(750000)
  groupDiscountPercent Float    @default(10)
  minParticipants      Int      @default(1)
  maxParticipants      Int      @default(15)
  difficulty           String   @default("Sedang (Trekking 3 Km)")
  altitude             String?  @default("2.769 mdpl")
  meetingPoint         String?  @default("Banyuwangi")
  departureTime        String?  @default("00:00 WIB")
  pickupArea           String?  @default("Banyuwangi City Area & Surrounds")
  safetyInfo           String?
  importantNotes       String?
  recommendedAge       String?  @default("7 - 65 Tahun")
  currency             String   @default("IDR")
  pricingUnit          String   @default("per orang")
  discountPrice        Float?
  priceNotes           String?
  packageType          String?  @default("Open Trip")
  metaTitle            String?
  metaDescription      String?
  ogImage              String?
  badge                String?  @default("Best Seller")
  rating               Float    @default(5.0)
  savedCount           String?  @default("1.500K")
  isTrending           Boolean  @default(true)
  isRecent             Boolean  @default(true)
  isFeatured           Boolean  @default(true)
  isActive             Boolean  @default(true)
  coverImage           String
  galleryImages        String   @default("[]") // JSON string array of URLs or {url, alt}
  highlights           String   @default("[]") // JSON string array
  includedItems        String   @default("[]") // JSON string array
  excludedItems        String   @default("[]") // JSON string array
  packingList          String   @default("[]") // JSON string array of objects/items
  faqs                 String   @default("[]") // JSON string array of {q, a}
  itineraries          String   @default("[]") // JSON string array of {day, title, desc, ...}
  addons               String   @default("[]") // JSON string array of addon objects
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookings  Booking[]
  reviews   Review[]
  schedules TripSchedule[]

  @@map("trip_packages")
}

model TripSchedule {
  id             String   @id @default(cuid())
  tripPackageId  String
  departureDate  String
  availableSlots Int      @default(15)
  bookedSlots    Int      @default(0)
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  tripPackage TripPackage @relation(fields: [tripPackageId], references: [id], onDelete: Cascade)

  @@map("trip_schedules")
}

model Booking {
  id              String    @id @default(cuid())
  bookingCode     String    @unique // e.g. IJN-20260925-A1B2
  userId          String?
  customerName    String
  customerEmail   String?
  customerPhone   String?
  whatsappNumber  String
  tripPackageId   String?
  packageName     String
  departureDate   String
  numParticipants Int       @default(1)
  basePrice       Float     @default(0)
  addons          String    @default("[]") // JSON string
  addonTotal      Float     @default(0)
  discountAmount  Float     @default(0)
  totalPrice      Float
  specialRequests String?
  pickupLocation  String?
  bookingType     String    @default("REGULAR") // REGULAR, CUSTOM
  customDetails   String?   // JSON string snapshot of custom options
  estimatedPrice  Float?
  finalPrice      Float?
  adminNotes      String?
  status          String    @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  paymentStatus   String    @default("PENDING") // PENDING, PAID, REFUNDED
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  tripPackage TripPackage? @relation(fields: [tripPackageId], references: [id])

  @@map("bookings")
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  image        String
  thumbnailUrl String?
  caption      String?
  category     String   @default("crater")
  isFeatured   Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("gallery_items")
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  image       String
  tag         String?
  isFeatured  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("destinations")
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  category   String   @default("Panduan")
  excerpt    String
  content    String
  image      String
  date       String
  readTime   String   @default("5 Menit Baca")
  author     String   @default("Tim Ekspedisi Ijen")
  isFeatured Boolean  @default(false)
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorUser User? @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  status     String   @default("UNREAD") // UNREAD, READ, REPLIED
  adminNotes String?
  createdAt  DateTime @default(now())

  @@map("contacts")
}

model Notification {
  id          String   @id @default(cuid())
  type        String   @default("booking") // "booking", "contact", "user", "system"
  title       String
  description String
  link        String?
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model Review {
  id                 String   @id @default(cuid())
  userId             String?
  tripPackageId      String?
  authorName         String
  authorEmail        String?
  rating             Int      @default(5)
  comment            String
  photoUrls          String   @default("[]")
  isApproved         Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  isVerifiedCustomer Boolean  @default(false)
  createdAt          DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  tripPackage TripPackage? @relation(fields: [tripPackageId], references: [id])

  @@index([emailVerified, isApproved])
  @@index([authorEmail])
  @@map("reviews")
}

model Staff {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  role        String   @default("Tour Guide") // "Tour Guide", "Senior Guide", "Lead Porter", etc.
  specialty   String?  // e.g. "Local Birding Guide", "Blue Fire Specialist", "Volcano Trekking"
  description String?  // Bio atau ringkasan pengalaman pemandu
  avatarUrl   String?  // URL foto profil
  experience  String?  @default("5+ Tahun")
  languages   String?  @default("Bahasa Indonesia, English")
  rating      Float    @default(5.0)
  reviewCount Int      @default(0)
  badge       String?  // e.g. "Lisensi HPI", "Certified Guide"
  phone       String?  // Kontak telepon / WhatsApp
  email       String?
  instagram   String?
  isFeatured  Boolean  @default(true)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("staff")
}

model EmailVerificationOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  type      String   @default("ADMIN_VERIFY") // "ADMIN_VERIFY", "REVIEW_VERIFY", "PASSWORD_RESET"
  targetId  String?
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([email, type, targetId])
  @@map("email_verification_otps")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  adminName String?
  action    String   // "CREATE_ADMIN", "UPDATE_ADMIN", "DEACTIVATE_ADMIN", "DELETE_ADMIN", "PASSWORD_RESET", "AUTH_FAILURE"
  targetId  String?
  details   String?  // JSON string of event details
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@map("audit_logs")
}


